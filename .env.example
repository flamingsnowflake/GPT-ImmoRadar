# Copy to .env on the server and fill in real values there.
# NEVER commit the real .env file.

# Telegram
TELEGRAM_BOT_TOKEN=<set-on-server>
TELEGRAM_CHAT_ID=<set-on-server>

# IMAP
IMAP_HOST=<set-on-server>
IMAP_PORT=993
IMAP_USER=<set-on-server>
IMAP_PASSWORD=<set-on-server>
IMAP_MAILBOX=INBOX.Immobilien

# Add additional non-secret variable names here as the project grows.
# Keep all real secret values outside Git.
