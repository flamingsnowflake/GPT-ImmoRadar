# Copy to .env on your server and fill in real values there.
# NEVER commit the real .env file.

# ------------------------------------------------------------
# Telegram bot
# ------------------------------------------------------------

TELEGRAM_BOT_TOKEN=<set-on-server>
TELEGRAM_CHAT_ID=<set-on-server>

# ------------------------------------------------------------
# IMAP listing mailbox
# ------------------------------------------------------------

IMAP_HOST=<set-on-server>
IMAP_PORT=993
IMAP_USER=<set-on-server>
IMAP_PASSWORD=<set-on-server>
IMAP_MAILBOX=INBOX.Immobilien

# Main monitor poll interval
POLL_SECONDS=120

# ------------------------------------------------------------
# Geocoding identification
# ------------------------------------------------------------

# Set a meaningful User-Agent/contact according to the Nominatim policy.
# Example only; use your own contact identity.
NOMINATIM_USER_AGENT=immobilien-monitor/1.0 (self-hosted; contact: contact@example.invalid)

# ------------------------------------------------------------
# Manual Energy API
# ------------------------------------------------------------

# Shared secret used by the Energy API and entered into the
# Tampermonkey userscript at runtime. Do not put a real value here.
ENERGY_API_TOKEN=<set-on-server>

# Host-side Docker port binding. Keep this loopback-only if an HTTPS
# reverse proxy is used in front of the API.
ENERGY_API_BIND=127.0.0.1
ENERGY_API_PORT=8090

# Optional container-internal override; defaults to 8090.
# ENERGY_API_INTERNAL_PORT=8090

# Optional Energy API database path override; normal container
# default is /data/database.sqlite3.
# DB_PATH=/data/database.sqlite3

# ------------------------------------------------------------
# Browser enrichment
# ------------------------------------------------------------

# Optional project-root override used by the public browser-enrichment
# service. The reference installation path is shown here.
IMMOBILIEN_MONITOR_ROOT=/opt/immobilien-monitor

# Browser enrichment intentionally uses a separate token file rather
# than putting the token into source control:
#
#   /opt/immobilien-monitor/config/browser_enrich_token
#
# Create that file with restrictive permissions and enter the same token
# into the Tampermonkey userscript when prompted.

# ------------------------------------------------------------
# Telegram webpage-preview user session (optional)
# ------------------------------------------------------------

# If you use the Telethon preview feature, keep its API credentials and
# generated session outside Git. The reference Compose setup mounts a
# private runtime directory at /telegram-preview.
